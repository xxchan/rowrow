{
  "name": "rowrow",
  "version": "0.3.12",
  "description": "Run a crew of coding agents in parallel and steer them from any browser, including your phone.",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "mobile",
    "remote-control"
  ],
  "homepage": "https://github.com/xxchan/rowrow#readme",
  "bugs": {
    "url": "https://github.com/xxchan/rowrow/issues"
  },
  "license": "Apache-2.0",
  "author": "xxchan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxchan/rowrow.git"
  },
  "bin": {
    "rowrow": "lib/cli/main.js"
  },
  "files": [
    "lib",
    "dist/web",
    "dist/kit",
    "!dist/web/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "setup": "pnpm install",
    "dev": "node scripts/dev.ts",
    "build": "run-p -l build:web build:kit build:node",
    "build:web": "vite build",
    "build:kit": "vite build --config vite.kit.config.ts",
    "build:node": "node --disable-warning=ExperimentalWarning scripts/build-node.ts",
    "build:bundle": "node scripts/build-bundle.ts",
    "build:desktop": "node scripts/build-desktop.ts",
    "desktop": "node scripts/desktop.ts",
    "package:desktop": "node scripts/package-desktop.ts",
    "prepack": "pnpm build",
    "start": "vite build && node src/cli/main.ts serve",
    "rowrow": "node src/cli/main.ts",
    "typecheck": "run-p -l typecheck:node typecheck:web typecheck:e2e",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.ts",
    "test:desktop": "vite build && node scripts/build-desktop.ts && playwright test -c playwright.desktop.config.ts",
    "ios:test": "swift test --package-path ios/RowrowCore",
    "test:package": "node scripts/test-package.ts",
    "shot": "node scripts/shot.ts",
    "check": "run-p -l typecheck lint format:check && vitest run"
  },
  "dependencies": {
    "@botiverse/oar": "^0.12.1",
    "@hono/node-server": "^2.1.1",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/openapi": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/zod": "^1.15.4",
    "hono": "^4.13.10",
    "immer": "^11.1.18",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
    "@pierre/diffs": "^1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "^1.63.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.48.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2001",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
