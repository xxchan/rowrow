{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".deps/**",
    "dist/**",
    "lib/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "unicorn/consistent-function-scoping": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@botiverse/oar",
                "message": "src/shared runs in the browser: import @botiverse/oar/observe",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "src/shared runs in the browser too: no Node built-ins"
              },
              {
                "group": ["**/server/**", "**/web/**", "**/cli/**"],
                "message": "src/shared depends on nothing else in src/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/kit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@botiverse/oar",
                "message": "the kit runs in JavaScriptCore: import @botiverse/oar/observe",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "the kit runs in JavaScriptCore: no Node built-ins"
              },
              {
                "group": ["**/server/**", "**/web/**", "**/cli/**"],
                "message": "the kit bundles src/shared, nothing else in src/"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@botiverse/oar",
                "message": "browser code: import @botiverse/oar/observe",
                "allowTypeImports": true
              },
              {
                "name": "@botiverse/oar/testing",
                "message": "Node-only"
              },
              {
                "name": "@botiverse/oar/kernel",
                "message": "Node-only"
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "browser code: no Node built-ins"
              },
              {
                "group": ["**/server/**", "**/cli/**"],
                "message": "the web app talks to the server only through the contract"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/desktop/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/cli/**"],
                "message": "the Mac app drives hosts through their rowrow CLI (--json, src/shared/host.ts) and servers through the contract, never their code"
              },
              {
                "group": ["./ui/**"],
                "message": "the app's pages run in a window: talk to them through the preload's API (api.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/desktop/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "the app's pages use window.rowrow (the preload), not Electron"
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "the app's pages run in a sandboxed window: no Node built-ins"
              },
              {
                "group": ["**/server/**", "**/cli/**"],
                "message": "the app's pages talk to the main process only through window.rowrow"
              },
              {
                "group": ["../*.ts", "!../api.ts"],
                "message": "the app's pages see the main process only through window.rowrow (types from ../api.ts)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli/**", "scripts/**", "test/**"],
      "rules": {
        "no-console": "off",
        "typescript/unbound-method": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["test/e2e/**"],
      "rules": {
        "no-empty-pattern": "off",
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
